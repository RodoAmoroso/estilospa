Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{SCRIPT_FILENAME} !-d
  RewriteCond %{SCRIPT_FILENAME} !-f
  RewriteRule ^(.+)$ index.php?uri=$1 [QSA,L]
</IfModule>


# Proteger archivo .env
<Files ".env">
  Order allow,deny
  Deny from all
</Files>

# Proteger archivos de configuración
<FilesMatch "\.(env|config|json)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Permitir acceso solo a archivos específicos de configuración
<Files "config.php">
  Order allow,deny
  Allow from all
</Files>