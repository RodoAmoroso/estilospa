.question-form
	margin 26px 0
.questions-wrapper
	padding 16px
	.question-box
		display flex
		margin-bottom 10px
		.icon 
			margin 0 16px 16px 0
			color gray(10)
			font-size 2rem
		.message
			.caption 
				font-size 1.5rem
				font-weight 300
				margin-bottom 0
			small
				font-size 1rem
				color gray(40)
	.response 
		border-bottom none
		margin-left 26px
		.icon 
			transform scale3d(-1,1,1)
.questions-wrapper:not(:last-of-type)
	border-bottom 1px solid gray(10)
	