Options -Indexes
DirectoryIndex index.php

#ErrorDocument 404 /estilospa/404.php

RewriteEngine On
RewriteCond %{SCRIPT_FILENAME} !-d
RewriteCond %{SCRIPT_FILENAME} !-f

<IfModule mime_module>
  AddType application/x-httpd-ea-php56 .php .php5 .phtml
</IfModule>

###RewriteCond %{HTTP_HOST} !^www\. [NC]
###RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
###RewriteCond %{HTTP:X-Forwarded-Proto} !https
###RewriteCond %{HTTPS} off
###RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteRule ^busqueda/([a-zA-Z0-9_-]*)/([a-zA-Z0-9_-]*)$ index.php?sct=busqueda&subsct=&q=$1&l=$2 [L]
RewriteRule ^([a-zA-Z0-9_-]*)/([a-zA-Z0-9_-]*)/([a-zA-Z0-9_-]*)$ index.php?sct=$1&subsct=$2&ids=$3 [L]
RewriteRule ^([a-zA-Z0-9_-]*)/([a-zA-Z0-9_-]*)$ index.php?sct=$1&subsct=$2 [L]
RewriteRule ^([a-zA-Z0-9_-]*)$ index.php?sct=$1 [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php56” package as the default “PHP” programming language.
<IfModule mime_module>
  AddType application/x-httpd-ea-php56 .php .php5 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
