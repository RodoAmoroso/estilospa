<!DOCTYPE html>
<html>
<head>
	<title>Listado de Códigos</title>
	<meta http-equiv="content-type" content="text/html; charset=utf-8" />
</head>
<body>

<table style="border:1px solid black">
	<thead>
		<tr>
			<th>Nro.</th>
			<th>Código</th>
		</tr>
	</thead>
	<tbody><tr><td style="border:1px solid black;padding:10px">1</td><td style="border:1px solid black;padding:10px"></td></tr>
	</tbody>
</table>

</body>
</html>