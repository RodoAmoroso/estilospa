.gift-card
	//border 5px solid $aqua_3
	background-color $aqua_3
	
	border-radius 8pt
	//height 200px
	display flex
	align-items center 
	justify-content center 
	text-align center
	//padding 2rem
	position relative
	overflow hidden
	transition all 600ms $cubic
	&:hover  
		.image 
			transform scale3d(1.05,1.05,1)
			&:after 
				height 100%
		.card-inside 
			height 100%
			align-items center
 
	.border 
		overprint()
		border-color white
		border-radius 4pt
		transform scale3d(.95,.95,1)

	.icon  
		position absolute
		color alpha($aqua_1,.5)
		opacity .5
		transform rotateZ(-15deg)
		transition all 600ms $cubic

		i 
			font-size 220pt

	.image 
		overprint()
		transition all 900ms $cubic
		&:after 
			content ''
			backdrop-filter blur(4px)      
			position absolute
			bottom 0
			left 0
			width 100%
			height 40%
			transition all 600ms $cubic

	.card-inside
		background-color alpha($aqua_6,.45)
		position absolute
		bottom 0
		left 0
		width 100%
		height 40%
		display flex 
		align-items flex-start 
		padding-top .25rem
		transition all 600ms $cubic

		.card-content
			color white
			position absolute
			font-size 18pt
			line-height 1.15
			width 100%
			.title 
				ff_birthstone()
				font-size 32pt
				margin-bottom 0
			.caption 
				font-size 12pt
				margin 0

			.price 
				font-size 20pt
				font-weight 800
				margin .25rem 0
	.card-caption
		color white 
		overprint()
		flex()
		padding 3rem
		.title-caption 
			font-size 18pt
		.small-caption 
			font-size 9pt
			margin-top 1rem
	
	&:hover 			
		background-color $aqua_4				
		.icon 
			transform rotateZ(0deg)

.gift-balance-notification
	background-color $aqua_5
	background-image linear-gradient(to bottom, $aqua_5, $aqua_6)
	border 1px solid $aqua_6
	text-align center
	padding 0.5rem 2rem
	box-shadow 0px 2px 10px 0 alpha(black,.5)
	//border-radius 6pt
	//position fixed 
	//bottom 1rem
	//right 1rem
	//transform translateY(110%)
	//z-index 10
	transition all 900ms $cubic 
	//min-height 200px
	//max-width 260px
	color $green_1
	position relative

	display flex 
	justify-content center
	align-items center
	.icon 
		font-size 60pt
		color $aqua_4
		margin-right 1rem
	.title 
		font-size 12pt
	.price 
		font-size 18pt 
		font-weight 900
		color $green_2
	.expiration 
		margin-top .25rem
		font-size 8pt
	.close-balance-notification
		position absolute
		cursor pointer
		top 0.5rem 
		right 0.5rem
		i
			color white

.gift-balance
	background-color $aqua_5
	background-image linear-gradient(to bottom, $aqua_3, $aqua_5)
	border-radius 4pt
	padding 0.5rem 2rem
	box-shadow 0px 2px 10px 0 alpha(black,.5)
	justify-content flex-start
	display flex 
	align-items center
	color $green_1
	position relative
	.icon 
		font-size 60pt
		color $aqua_3
		margin-right 1rem
	.actions
		position absolute
		top 1rem
		right 1rem
	.content 
		padding 1rem
	.title 
		font-size 12pt

.giftcards-bakground-gallery
	.owl-stage-outer
		padding-bottom 16px
	.thumbnail
		border 2px solid gray(10)
		border-radius 10pt 
		background-color white
		background-size cover
		background-position center
		cursor pointer
		&:hover 
			opacity .65
	.thumbnail.selected
		border-color $fucsia_4
		position relative
		&:after 
			content ''
			border-top 8px solid transparent
			border-right 8px solid transparent
			border-bottom 8px solid $fucsia_4
			border-left 8px solid transparent
			left calc(50% - 8px)
			height 16px
			width 16px
			position absolute 
			bottom -8px


.giftcard-code-input
	display flex
	justify-content space-between
	input
		border 1px solid $aqua_1
		border-radius 6pt
		font-family 'Courier', sans-serif
		font-weight bold
		font-size 18pt 
		text-align center
		height 60px
		width 11%
		max-width 60px
		color $fucsia_4
		color $aqua_3
		margin 1rem 0 1rem 0
		text-transform uppercase
		&:focus,
		&:active
			border-color $aqua_4
			outline none
		&:hover 
			border-color $aqua_4