footer
	padding 66px 0
	.bg
		//filter grayscale(100%)
		//mix-blend-mode multiply
		opacity 1
	.container
		.logo
			max-width 240px
		.socials
			justify-content flex-start
			.icon
				color white
				border-color white
		ul
			li
				display block
				a
					color white
					display block
					padding .225rem 0
					font-size 11pt
					&:hover,&:focus
						color $aqua_3
						text-decoration none

	
			
.copyright-footer
	padding 16px 0 36px 0
	background-color black
	color white
	.afip
		position absolute 
		right 1rem
		bottom 0
		img
			max-width 50px
	@media screen and (max-width 991px)
		.afip
			position relative 
			right auto
			display block
			text-align center
			margin-top 1rem
			width 100%

.newsletter
	background-color $aqua_5
	box-shadow inset 0 4px 6px rgba(22,80,94,0.30)
	padding 4rem 0
	text-align center

.payment
	padding 2rem 0
	background-color black
	color white
	text-align center
	.cards
		img
			filter grayscale(100%)
			height 30px
			margin 6px
	.afip
		position absolute
		right 0
		bottom 0
		img
			max-width 40px