
.cybermonday-bar
	background-color black
	background-color $cyan_4
	padding 6rem 1rem
	position relative
	color white
	.bg
		opacity .15
		filter grayscale(100%)
	.title
		font-weight 600

	@media screen and (max-width 991px)
		text-align center


.cybermonday-landing
	border-bottom 6px solid gray(5)
	padding 4rem 1rem 10rem 1rem
	.logo
		max-width 200px

	.form-wrapper
		background-color gray(80)
		border-radius .75rem
		padding 3rem
		label,a
			color white