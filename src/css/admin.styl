@import 'common/colours'
@import 'common/fonts'
@import 'common/functions'
@import 'common/variables'

.header-admin
	.logo 
		padding 36px 10px
	.nav-tabs
		li
			display inline-block
			float none
			vertical-align top 
		.active
			a
				background-color gray(5)
				background-color #ADD8E6
				color white
.page-header
	background-color gray(30)
	background-color $fucsia_2
	background-color $aqua_3
	color white
	padding 40px 0 9px 0
	position relative
	margin 0
	hr 
		margin 0 0 16px 0
	h1
		font-weight 700
	p 
		font-size 11pt


.admin-gallery
	max-height 280px
	overflow auto
	.thumbnail
		margin 2px
		position relative
		.redbg 
			background-color rgba(150,20,30,0.65)
			display none
			height 100%	
			left 0
			position absolute
			top 0
			width 100%
			i 
				cursor pointer
				&:hover 
					color orange
			.delete
				position absolute
				right 8px
				color white
				top 8px
		&:hover
			.redbg 
				display block	

.admin-box
	padding 0 0 10px 0
	.container
		padding-top 16px
		padding-bottom 16px
		//Shadow(1px 1px 2px 1px rgba(0,0,0,0.10))
			
.mod-menu-container
	min-height 100px
	max-height 696px
	overflow auto
	.mod-menu
		Transition(opacity,300ms,ease-out)
		margin-bottom 2px
		&:hover 
			opacity 0.6
.mod-container
	max-height 580px
	overflow auto
	.mod-item
		background-color  white
		border 1px solid gray(10)
		margin 2px 0 6px 0
		opacity 1
		padding 10px
		position relative
		border-radius 4px 
		box-shadow 2px 2px 4px 0 rgba(0,0,0,0.25)
		Transition(all 300ms ease-out)
		&:hover 
			border 1px solid gray(20)
			box-shadow 2px 2px 4px 0 rgba(0,0,0,0.15)
		.thumbnail
			margin-bottom 0
			height 80%
			position absolute
			width 80px 
		.data
			overflow hidden
			margin 0 130px 0 90px
			hr 
				margin 8px 0 8px 0
			.buttons
				top 10px 
				position absolute
				right 10px
			.options
				bottom 10px
				position absolute
				right 10px

.mod-card	
	Transition(width 300ms ease-out)
	margin 0 0 4px 0
	.card-inner
		border 1px solid gray(10)
		overflow hidden
		margin-bottom 8px
		transition box-shadow 300ms ease-out
		&:hover 
			Shadow(5px 5px 6px 1px rgba(0,0,0,0.16))
		.thumb
			position relative
			.buttons 
				position absolute
				bottom 10px
				right 10px
			.selector
				left 8px 
				position absolute
				top 8px			
		.caption
			background-color white
			position relative
			h1,h2
				font-weight 700
				font-size 11pt
				height 40px
				line-height 16pt
				padding 10px 76px 6px 10px
				margin 2px 0
				overflow hidden
				position relative
				white-space nowrap
				&:after
					background-image linear-gradient(left, rgba(255,255,255,0), white)
					content ''
					height 40px
					position absolute
					width 80px
					right 0
					top 0					
			hr 
				margin 0
			p 
				font-size 10pt
				padding 10px
				margin 0
				strong
					color #01957B
			h2
				font-size 10pt
				padding 0 10px
				font-weight 400
				height auto
			h1.sm
				font-size 9pt
			.buttons
				display none
				position absolute
				top 10px
				right 10px
			.foot 
				align-items center
				border-top 1px solid gray(10)
				color gray(65)
				display flex 
				justify-content space-between
				padding 6px 10px
				text-align right	
			/*.edit
				cursor pointer
				position absolute
				top -20px
				right 10px
				.fa-circle
					Transition(color 300ms ease-out)
				&:hover 
					.fa-circle 
						color black
			.edit-list
				top 16px*/
.mod-container-xs
	height 120px
	overflow auto
.mod-container-sm
	height 240px
	overflow auto
.mod-container-md
	height 360px
	overflow auto
.mod-container-lg
	height 620px 
	overflow auto
.mod-list-thumb
	background-color  white
	border 1px solid gray(10)
	margin 2px 0 6px 0
	opacity 1
	padding 10px
	position relative
	border-radius 4px
	box-shadow 2px 2px 4px 0 rgba(0,0,0,0.25)
	transition all 300ms ease-out
	&:hover 
		border 1px solid gray(20)		
		box-shadow 2px 2px 4px 0 rgba(0,0,0,0.15)
	.thumbnail
		margin-bottom 0
		height 80%
		position absolute
		width 80px 
	.data
		overflow hidden
		margin 0 130px 0 90px
		hr 
			margin 8px 0 8px 0
		.buttons
			top 10px 
			position absolute
			right 10px
		.options
			bottom 10px
			position absolute
			right 10px
.mod-list
	background-color white
	border 1px solid gray(10)
	margin-bottom 4px
	overflow hidden
	padding 4px 14px
	position relative
	border-radius 2px 
	///Transition(shadow 200ms linear)
	&:hover 
		box-shadow 2px 2px 4px 0 rgba(0,0,0,0.12)
	h4
		margin-right 50px
		font-size 10pt
		font-weight 400
	.buttons
		position absolute
		top 10px
		right 10px		
	p 
		font-size 9pt
		color gray(50)
	small 
		color gray(60)
		font-family 'Open Sans', sans-serif
		font-size 8pt
	hr
		margin 6px 0
.mod-list.active 
	background-color $aqua_2
	border 1px solid $aqua_3
	&:after
		background-color black
		content ''
		left -5px
		top 38%
		height 10px
		position absolute
		transform rotateZ(45deg)
		width 10px		
	&:hover 
		box-shadow none

.form-group
	position relative

.panel-admin-mod
	.panel-heading 
		background-color gray(10)
		color gray(60)
		padding 6px 16px
	.panel-body
		margin 0
		padding 0
		.list-group 
			margin-bottom 0
			.list-group-item
				position relative
				border none
				border-top 1px solid gray(10)
				border-radius 0				
				.buttons
					right 10px
					top 10px
					position absolute
				.item
					margin-right 50px
					i 
						cursor pointer
						margin 0 8px 0 0
			.list-group-item:first-of-type
				border-top none

.block-buttons
	position relative
	.inactive-block
		background-color rgba(255,255,255,.8)
		cursor not-allowed
		display none
		left 0
		position absolute
		top 0
		height 100%
		width 100%
	.inactive-block.active
		display block
.tab-content
	background-color white
	margin 0 0 8px 0
	.tab-panel
		border-left 1px solid gray(10)	
		border-right 1px solid gray(10)	
		border-bottom 1px solid gray(10)
		padding 36px 26px
		position relative
		display none
		&:first-of-type
			display block
		.pop
			background-color rgba(255,255,255,0.95)
			height 100%
			left 0
			padding 16px
			position absolute
			top 0
			width 100%
			z-index 3
			h1 
				font-size 18pt
			.close 
				position absolute
				right 16px
				top 16px
				opacity 1
				font-size 9pt
				&:hover 
					color $fucsia_3
.pop-schedules 
	.row-days
		overflow auto
		margin 6px 0
		.form-inline
			margin 0 0 16px 0
		button.active
			background-color $aqua_3
			color white
	.hours 
		margin 16px 0
		display flex
		flex-wrap wrap
		button
			border 1px solid $aqua_1
			cursor pointer
			display inline-block
			font-family 'Fira Sans Condensed', sans-serif
			margin 0 4px 4px 0
			padding 10px 0
			text-align center
			width 64px
			&:hover 
				background-color $aqua_1
		button.active 
			background-color $aqua_3
			color white
.flex-options
	display flex 
	.flex-item
		border 1px solid gray(10)
		cursor pointer
		padding 10px 16px
		margin 0 10px 0 0
		&:hover 
			background-color gray(5)
.cke_editable
	padding 18px
.ui-datepicker
	z-index 3 !important
.block-box
	background-color white
	border 1px solid gray(10)
	border-top 4px solid $aqua_3
	box-shadow 2px 2px 8px rgba(0,0,0,0.1)
	padding 0
	margin 0 0 8px 0
	.box-title,.box-content,.box-footer
		padding 8px 26px
	h1,h2,h3,h4,h5,h6,p,small
		margin 6px 0
	.box-title 
		border-bottom 1px solid gray(5)
	.box-footer
		border-top 1px solid gray(5)
