@import 'https://fonts.googleapis.com/css?family=Fira+Sans+Condensed:100,300,400,700|Fira+Sans:300,400,500,600,700|Ubuntu:400'

@import 'common/colours'
@import 'common/fonts'
@import 'common/functions'
@import 'common/variables'
@import 'common/elements'
@import 'common/buttons'
@import 'common/modules'


body
	font-family 'Proxima Nova', sans-serif
	font-weight normal
	Antialiased()
	position relative
h1,h2,h3,h4
	font-family 'Fira Sans', sans-serif
	font-weight 300
	line-height 1.25

section,footer,header
	position relative
	.container
		position relative
a
	color gray(60)
	Transition(color 300ms ease-out)
label
	span
		font-weight 300
		font-style italic

header.header
	.container
		.header-inner
			align-items center
			display flex
			justify-content space-between
			.logo
				img
					padding 16px 0
					max-width 220px
					width 100%
			.user
				min-width 180px
				padding 16px 0
				position relative
				ul.menu-login
					margin 0
					padding 20px 0
					text-align right
					li
						display inline-block
						vertical-align top
						a
							display block
							font-size 10pt
							padding 0 10px 0 0
						&:hover
							a
								color $fucsia_2
								text-decoration none
					.separator
						padding 0 10px 0 0
			.user-logged
				align-items center
				display flex
				justify-content flex-end
				.avatar
					background-color gray(10)
					height 40px
					min-width 40px
					margin 0 8px
					border-radius 4px
					width 40px
				.user-title
					cursor pointer
					font-size 11pt
					font-weight 400
					margin 0
					position relative
					a
						display block
						i
							margin 0 6px
						&:hover,&:focus
							color $fucsia_3
							text-decoration none
				.menu-user-container
					margin 70px 0 0 0
					position absolute
					right 0
					//transform rotate3d(1,0,0,54deg)
					transform matrix3d(1,0,0.00,0,0.00,0,1.00,-0.001,0,-1,0,0,0,0,0,1)
					transform-origin top
					transition transform 200ms linear
					top 0
					width 100%
					z-index 10
					ul.menu-user
						background-color white
						border 1px solid gray(10)
						padding 0
						border-radius 8px
						box-shadow $shadow
						text-align left
						overflow hidden
						width 100%
						li
							display block
							a
								align-items center
								display flex
								font-size 10pt
								color gray(80)
								margin 0
								padding 6px 10px
								transition background-color 300ms ease-out
								i
									width 18px
								&:hover,&:focus
									background-color $fucsia_3
									background-color $aqua_3
									text-decoration none
									color white
								.notify-icon
									align-items center
									background-color $fucsia_3
									border-radius 50%
									color white
									display flex
									font-size 1.05rem
									height 18px
									justify-content center
									//padding .165rem .865rem
									margin-left .875rem
									width 18px
						li:first-of-type
							margin-top 12px
						li.separator
							border-top 1px solid gray(10)
						li.highlight
							a
								color $fucsia_3
					.arrow
						background-color white
						border-top 1px solid gray(10)
						border-left 1px solid gray(10)
						top -7px
						height 16px
						left 44px
						transform rotate3d(0,0,1,45deg)
						position absolute
						width 16px
				.menu-user-container.active
					//height auto
					//transform rotate3d(1,0,0,0deg)
					transform matrix3d(1,0,0.00,0,0.00,1,0.00,0,0,0,1,0,0,0,0,1)
nav.main-nav
	background-color $aqua_5
	ul.main-menu
		display flex
		//justify-content center
		margin 0
		padding 0
		li
			display block
			margin 0
			text-align center
			transition background-color 300ms ease-out
			list-style-type none
			a
				color white
				display block
				font-family 'Fira Sans Condensed', sans-serif
				//font-size 11pt
				font-size 1.45rem
				font-weight 300
				//letter-spacing 0.1pt
				padding 1rem 1.25rem
			&:hover
				background-color $aqua_3
				a
					color white
					text-decoration none
		.active
			background-color $aqua_3
		.highlight
			background-color $fucsia_3
		.highlight-promo
			background-color $aqua_2
			a
				color $cyan_4
	.fa-bars
		display none
		padding 16px
		color white


.section-header
	padding 80px 0
		&:hover
			color white
			text-decoration none

footer
	padding 66px 0
	.bg
		//filter grayscale(100%)
		//mix-blend-mode multiply
		opacity 1
	.container
		.logo
			max-width 240px
		.socials
			justify-content flex-start
			.icon
				color white
				border-color white
		ul
			li
				display block
				a
					color white
					display block
					padding 6px 0
					&:hover,&:focus
						color $fucsia_3
						text-decoration none
.copyright-footer
	padding 16px 0 36px 0
	background-color black
	color white

.top-menu
	background-color $aqua_1
	border-bottom 1px solid $aqua_2
	.container
		ul
			margin 0
			padding 0
			li
				display inline-block
				vertical-align top
				a
					color $aqua_5
					display block
					font-size 7pt
					font-weight 600
					padding 5px 0 4px 0
				&:hover
					a
						color black
						text-decoration none
		ul.right-menu
			display flex
			position absolute
			right 10px
			top 0
			li
				border-left 1px solid $aqua_2
				padding 0
				margin 0
				a
					padding 6px 10px 4px 10px
					i
						font-size 9pt
				a:hover
					background-color white
			li:last-of-type
				border-right 1px solid $aqua_2

.home-slider
	margin 0
	display none
	.container-fluid
		.row
			.col-right,.col-left
				margin 0
				.mod-slide
					display block
					position relative
					.next,.prev
						background-color white
						cursor pointer
						display block
						padding 10px 8px
						position absolute
						top 44%
						transition padding 300ms $cubic
						&:hover
							padding 10px 16px
					.next
						right 0
					.prev
						left 0
					.slide
						.caption
							background-color rgba(33,86,99,0.85)
							color white
							bottom 0
							left 0
							padding 8px 36px
							position absolute
							width 100%
							h1,h2,h3,h4
								margin 4px 0
					.navigation
						display none
						position absolute
						right 10px
						top 10px
						i
							color $aqua_2
						i.active
							color $fucsia_3
			.col-left
				padding 4px 4px 4px 0
			.col-right
				padding 4px 0 4px 0
				.mod-slide:first-of-type
					margin-bottom 4px
.slider-wide
	background-color gray(5)
	.sliders
		position relative
		padding 15.35%
		.slide
			opacity 0
			visibility hidden
			background-position left center
			background-size cover
			position absolute
			left 0
			top 0
			height 100%
			width 100%
			transition all 900ms $cubic
			img
				width 100%

		.slide.active
			opacity 1
			visibility visible

		.dots
			bottom 0
			padding 1rem
			left 0
			position absolute
			text-align center
			width 100%
			i
				color white
				font-size 9pt
				cursor pointer
				text-shadow 1px 1px 2px black
				margin 0 4px
				&:before
					content '\f111'
					font-family 'FontAwesome'
			i.active
				color $fucsia_3
			i.active:before
				font-family 'FontAwesome'
		.prev,.next
			align-items center
			color white
			cursor pointer
			display flex
			height 100%
			padding 0 8px 0 8px
			position absolute
			top 0
			i
				font-size 5rem
				text-shadow 1px 1px 2px black
			&:before
				content ''
				height 100%
				opacity 0
				left 0
				position absolute
				transition opacity 300ms ease-out
				width 100%
			&:hover
				&:before
					opacity 1
		.prev
			left 0
			&:before
				background-image linear-gradient(left, rgba(0,0,0,0.6), rgba(0,0,0,0))
		.next
			right 0
			&:before
				background-image linear-gradient(right, rgba(0,0,0,0.6), rgba(0,0,0,0))

	@media screen and (max-width 991px)
		.sliders
			padding 26%
			.prev,.next
				i
					font-size 2rem


.news-home
	padding 36px 0
.home-carousel
	margin 0


.carousel
	padding 16px 0
.search-bar,.newsletter
	background-color $aqua_1
	border-bottom 1px solid $aqua_2
	box-shadow inset 0 4px 6px rgba(22,80,94,0.30)
	padding 16px 0 10px 0
	input[type="text"],.input-group-addon,select
		border 1px solid $aqua_2
		border-bottom-right-radius 0
		border-bottom-left-radius 0
	.input-group,button
		margin 4px 0
	button,.input-group-addon
		color $aqua_0
		border-color transparent
		background-color $aqua_3
		&:hover
			background-color $aqua_2
			border-color $aqua_3
.search-bar-category
	background-color $green_1
	border-bottom 1px solid $green_2
	input,select
		border 1px solid $green_2 !important
	button,.input-group-addon
		color $aqua_0
		border-color transparent
		background-color $green_2
		&:hover
			background-color $green_2
			border-color $green_2

#glossary_carousel
	padding 6px 0 2px 0
	margin 0
.clients-carousel
	padding 16px 10px
	display flex
	flex-wrap wrap
	.mod-client
		background-color white
		border 1px solid #dfdfdf
		display block
		transition 300ms all ease-out
		height 100%
		&:hover
			border 1px solid cyan_2
			box-shadow 5px 5px 6px alpha(black,.1)
			//transform translateY(-1px) translateX(-1px)
			opacity .85
			text-decoration none
		.wrapper
			height 100%
			position relative
			.thumb
				position relative
				.fav
					right 8px
					color gray(15)
					cursor pointer
					position absolute
					top 6px
					font-size 2.5rem
					&:hover
						color $fucsia_3
					.active
						color $fucsia_3
			.data
				border-top 1px solid #dfdfdf
				//height 100px
				margin-bottom 20px
				padding 10px
				.title
					color black
					font-weight 500
					line-height 1.15
				.subtitle
					margin-top 10px
					color gray(50)
					font-size 1.15rem
					line-height 1.4
			.location
				background-color gray(3)
				bottom 0
				font-size 1.15rem
				padding 4px 8px
				//overflow hidden
				white-space nowrap
				position absolute
				width 100%
				&:after
					content ''
					//background-color white
					background-image linear-gradient(top,alpha(white,0),white)
					position absolute
					top -10px
					left 0
					height 10px
					width 100%

.promos-highlight
	padding 0
	display flex
	flex-wrap wrap
	position relative
	.mod-promo
		padding 0 15px 15px 0
		//background-color white
		position relative
		display block
		width 100%
		&:hover
			text-decoration none
			.wrapper
				box-shadow 0px 0px 6px alpha(black,.35)
		.wrapper
			align-content space-between
			box-shadow 2px 2px 4px alpha(black,.05)
			background-color white
			border 1px solid alpha($aqua_3,.5)
			display flex
			flex-wrap wrap
			height 100%
			position relative
			transition 300ms all ease-out
			.mod-body
				width 100%
				.image-wrapper
					background-color gray(5)
					position relative
					height 150px
					.sale-tag
						position absolute
						top 8px
						left -5px
						span
							background-color $aqua_3
							font-weight 500
							color #fff
							font-size 9pt
							padding 6px 10px
							position relative
						&:before
							border-right 5px solid black
							border-left 5px solid transparent
							border-top 5px solid transparent
							border-bottom 5px solid transparent
							bottom -9px
							content ''
							height 0
							position absolute
							left -5px
							width 0
					.fav
						right 8px
						color gray(15)
						cursor pointer
						position absolute
						top 6px
						font-size 2.5rem
						&:hover
							color $fucsia_3
						.active
							color $fucsia_3
				.content
					padding 8px
					width 100%
					.title
						color $aqua_5
						display block
						font-weight 500
						padding 0
						font-size 1.5rem
						word-wrap break-word
						line-height 1.2
					.subtitle
						color gray(50)
						margin 6px 0
						font-size 1.2rem
						line-height 1.4
					.location
						display block
						color $aqua_3
						margin-top 0
						margin 10px 0 0 0
						font-size 1.3rem
						line-height 1.2
						i
							margin-right 4px

			.mod-footer
				border-top 1px solid gray(5)
				padding 0
				position relative
				width 100%
				.actions
					align-items flex-end
					display flex
					height 100%
					justify-content space-between
					margin 0
					padding 10px
					.pricing
						width 50%
						.price
							color gray(80)
							font-weight 500
							font-size 1.8rem
						.strikethrough
							color gray(40)
							font-size 1.2rem
					.promo-buttons
						width 50%
	.mod-promo-6
		width (100/6)%
	.mod-promo-5
		width (100/5)%
	.mod-promo-4
		width (100/4)%
	.mod-promo-3
		width (100/3)%
	.mod-promo-2
		width (100/2)%
	.mod-promo-1
		width 100% !important
		padding 0 0 15px 0
		.wrapper
			.mod-body
				.content
					.title
						height auto
.promo-buttons
	position relative
	min-width 136px
	.main-button
		background-color $aqua_3
		display flex
		justify-content space-between
		&:hover,&:focus
			background-color $aqua_4
			a
				text-decoration none
		a
			color white
			padding 2px 8px
			display block
			font-size 1.3rem
			font-family 'Fira Sans Condensed'
			width 100%
		i.icon
			min-width 32px
			width 32px
			color white
			padding 3px 10px
			font-size 1.4rem
		i.arrow
			min-width 24px
			width 24px
			background-color $aqua_5
			cursor pointer
			color white
			padding 4px 8px
			&:hover
				background-color $aqua_6
	ul
		border 1px solid cyan_1
		box-shadow 2px 2px 6px alpha(black,.07)
		margin 0
		padding 0
		position absolute
		width 100%
		z-index 99
		li
			align-items center
			background-color white
			font-size 1.325rem
			display flex
			a
				color $aqua_5
				font-family 'Fira Sans Condensed'
				padding 6px 16px
			&:hover,&:focus
				background-color $aqua_5
				i
					color white
				a
					color white
					text-decoration none
			i
				color $aqua_5
				padding 6px 10px

.payment
	padding 16px 0
	.cards
		img
			filter grayscale(100%)
			height 30px
			margin 6px
	.afip
		position absolute
		right 0
		bottom 0
		img
			max-width 40px

.bg-gradient
	background-image linear-gradient(top, $fucsia_3, $cyan_3)


.search-page
	background-color gray(5)
	padding 10px 0
	.container,.container-fluid
		.search-header
			padding 10px 26px
		.search-container
			display flex
			align-items flex-start
			.left-column
				background-color white
				border 1px solid gray(10)
				flex-grow 0
				min-width 280px
				padding 16px
				width 280px
				.title-bar
					cursor pointer
					padding 4px 10px
					margin 0 0 6px 0
					text-align left
					i
						float right
				ul.list
					margin 0 0 26px 0
					padding 0
					li
						display block
						a
							border-bottom 1px solid gray(5)
							display block
							font-size 9pt
							padding 6px 4px
							position relative
							span:first-of-type
								display block
								margin-right 36px
							.badge
								background-color gray(20)
								right 8px
								position absolute
								top 8px
							i
								right 12px
								position absolute
								top 8px
							&:hover
								background-color gray(5)
								text-decoration none
								color $cyan_2
						ul
							margin 0
							padding 0
							li
								a
									margin 0 0 0 6px
				.filters
					margin 0 0 16px 0
				.title-zones
					display none
					margin-bottom 1rem
				.tag
					background-color $cyan_2
					display flex
					justify-content space-between
					color white
					span
						padding .365rem 1rem
						display inline-block
					&:hover,&:focus
						background-color $cyan_3
						text-decoration none
						span.remove
							background-color $cyan_4

			.right-column
				overflow hidden
				padding-left 8px
				width 100%
				.filters
					padding 8px 0

		@media screen and (max-width 991px)
			.search-container
				flex-wrap wrap
				.left-column
					margin-bottom 1rem
					width 100%
					.title-zones
						display block
					ul.list
						display none
					ul.list.active
						display block


.header-overview
	padding 8px 0 16px 0
	.container
		hr
			margin 8px 0
		.row
			.contact-info
				line-height 20pt
				i
					width 14px
					text-align center
					margin-right 4px

.overview
	background-color gray(5)
	padding-bottom 46px
	.breadcrumb
		background-color white
		margin 10px 0 6px 0
		border-radius 0
		box-shadow 0 2px 6px gray(8)
	.title
		text-align left
		padding-left 16px
	.overview-header,.overview-promos,.overview-info,.overview-comments,.overview-tags
		background-color white
		Shadow(0 2px 6px gray(8))
		margin-bottom 6px
	.overview-header
		background-color white
		display flex
		min-height 360px
		.info,.gallery
			position relative
		.gallery
			background-color white
			border-left 1px solid gray(10)
			width 100%
			.navigation
				i
					font-size 1rem
					margin 0
		.info
			padding 16px
			min-width 476px
			width 476px
			.button-request
				.btn-default
					background-color $aqua_4
					border-color $aqua_3
					color white
			h1
				margin 0
			hr
				margin 0
			.header-info
				align-items flex-start
				display flex
				text-align left
				padding 10px 0
				margin-bottom 6px
				.logo
					border 1px solid gray(20)
					background-color white
					min-width 120px
					height 120px
					width 120px
				.title
					margin 0 0 0 6px
					h1
						margin 0
						font-size 22pt
			.contact-info
				border-bottom 1px solid gray(5)
				padding 0
				position relative
				margin 0
				.address,.more-stores,.phones,.whatsapp,.web,.schedules
					padding 6px 0
				i.icon
					float left
					color $aqua_3
					margin 2px 6px 0 0
					width 14px
			.box-icons
				//text-align center
				padding 16px 0
				margin 0
				width 100%
				.item
					//border-bottom 1px solid gray(5)
					padding 6px 0
					margin 0
					.outer
						display flex
						justify-content space-between
						height 100%
						.inner
							//align-items center
							display flex
							.rating
								.punctuation
									font-size 10pt
									font-weight 200
							.fa
								color $aqua_3
							.fa-inverse
								color white
							.fa-stack:hover
								.fa-circle
									color black
							.fa-heart-o,.fa-heart
								cursor pointer
								font-size 20pt
							.active
								color $fucsia_3
							.fa-eye
								font-size 20pt
								&:hover
									color black
	.overview-promos
		padding 16px

.stores-highlight
	display none
	transition  height 300ms $cubic
.stores-highlight.active
	display block

#map
	background-color gray(10)
	position relative
	height 536px
	transition height 300ms $cubic
	iframe
		height 100%
		position absolute
		width 100%
#map.active
	height 360px

#stores
	border 1px solid gray(5)
	background-color gray(5)
	border-radius 4px
	padding 10px
	height 560px
	overflow auto
	.list-group
		.active
			background-color $yellow_1
			border-color $yellow_2
			color black
		h4
			font-weight bold
			margin 0
		ol
			margin 0
			padding 4px 0
			li
				display block
				padding 6px 0
				font-size 10pt
.schedules
	cursor pointer
	position relative
	.schedules-block
		background-color white
		box-shadow 2px 2px 4px rgba(0,0,0,0.2)
		left 0
		overflow hidden
		padding 8px 16px
		position absolute
		transform matrix3d(1,0,0.00,0,0.00,0,1.00,-0.001,0,-1,0,0,0,0,0,1)
		transform-origin top
		transition transform 400ms cubic-bezier(0.23,1,0.32,1)
		border 1px solid gray(20)
		z-index 10
		p
			font-size 9pt
			margin 6px 0
	.schedules-block.active
